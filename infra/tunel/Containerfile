# Imagen del tunel de Cloudflare que saca BLOKY Dev a internet por HTTPS.
# T-76 · ADR-0011 · ADR-0014. Contexto de construccion: la raiz del repositorio.
#
#   podman build -f infra/tunel/Containerfile -t idiky-tunel .
#
# No compila nada: fija la version de cloudflared para que el servidor no la cambie sola. El
# tunel solo hace conexiones de SALIDA hacia Cloudflare; no publica puertos ni necesita reglas
# en Azure. Su token va en ~/.config/idiky/secretos/tunel.env (infra/tunel/secretos.sh).
FROM docker.io/cloudflare/cloudflared:2026.9.1

# Sin --metrics el contenedor no tiene forma de decir «ya estoy conectado»; con el, /ready
# responde 200 cuando hay al menos una conexion viva con Cloudflare. levantar.sh lo publica
# solo en 127.0.0.1 del servidor.
ENTRYPOINT ["cloudflared", "--no-autoupdate", "--metrics", "0.0.0.0:2000", "tunnel", "run"]

ARG REVISION=sin-revision
LABEL org.idiky.revision="$REVISION"
