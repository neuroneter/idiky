# Configuracion comun de Evolution API (sin secretos). T-131 · ADR-0033.
# levantar.sh la copia a ~/.config/idiky/evolution-comun.env (ruta estable para systemd).

SERVER_PORT=8080
LOG_LEVEL=ERROR,WARN,INFO
DEL_INSTANCE=false

DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
# En Dev no hace falta guardar historial completo: aligerar Baileys ayuda a que salga el QR
# (issue Evolution #2437: count:0 / QR que no aparece).
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false
DATABASE_CONNECTION_CLIENT_NAME=idiky_evolution

# Cache local para el QR; Redis sigue en el pod para otras piezas, pero Baileys no lo usa aqui.
CACHE_REDIS_ENABLED=false
CACHE_REDIS_PREFIX_KEY=idiky_evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=true

RABBITMQ_ENABLED=false
S3_ENABLED=false

QRCODE_LIMIT=30
QRCODE_COLOR=#198754

# Cliente de WhatsApp Web (Baileys). Version reciente: sin ella a menudo no hay QR.
CONFIG_SESSION_PHONE_CLIENT=Chrome
CONFIG_SESSION_PHONE_NAME=Chrome
CONFIG_SESSION_PHONE_VERSION=2.3000.1033773198

# Preferir IPv4: el servidor Lightsail tiene IPv6 y Baileys a veces falla en silencio.
NODE_OPTIONS=--dns-result-order=ipv4first
