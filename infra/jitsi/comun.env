# Configuracion comun de las piezas de Jitsi (T-78 · ADR-0016). NO tiene secretos: va en git.
# levantar.sh se la pasa a los cuatro contenedores del pod con --env-file, junto con
# ~/.config/idiky/secretos/jitsi.env, que si tiene las claves.
#
# Dentro del pod todos comparten la red, asi que el XMPP esta en 127.0.0.1.

TZ=America/Bogota

# Dominios internos de XMPP. No son nombres de internet: viven dentro del pod.
XMPP_DOMAIN=meet.jitsi
XMPP_AUTH_DOMAIN=auth.meet.jitsi
XMPP_MUC_DOMAIN=muc.meet.jitsi
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.jitsi
XMPP_SERVER=127.0.0.1
XMPP_BOSH_URL_BASE=http://127.0.0.1:5280

JICOFO_AUTH_USER=focus
JVB_AUTH_USER=jvb
JVB_BREWERY_MUC=jvbbrewery

# Sin cuenta no se ABRE una sala; para ENTRAR a una sala abierta basta el enlace. Es lo que
# sustituye a la clave del entorno, que no se puede usar aqui (ver nginx.conf).
ENABLE_AUTH=1
AUTH_TYPE=internal
ENABLE_GUESTS=1
ENABLE_LOBBY=1

ENABLE_XMPP_WEBSOCKET=1
ENABLE_COLIBRI_WEBSOCKET=1

# El certificado lo pone el tunel de Cloudflare (ADR-0014), no Jitsi: dentro del pod es HTTP.
DISABLE_HTTPS=1
ENABLE_LETSENCRYPT=0
ENABLE_HTTP_REDIRECT=0

# Dos JVM en un servidor con 5 GB para TODO idiky (README §2). Por defecto estas imagenes
# piden hasta 3 GB de heap cada una, que aqui no existen.
JICOFO_MAX_MEMORY=256m
VIDEOBRIDGE_MAX_MEMORY=512m

# Habilita /about/health del videobridge en su 8080, dentro del pod: es como se comprueba
# que el video esta sano (infra/jitsi/README.md).
COLIBRI_REST_ENABLED=1
