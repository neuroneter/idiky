# Variables del sistema de gestion (T-37 · ADR-0012). Copiar a .env para desarrollar en local.
# En el entorno de desarrollo NO se usa este archivo: los secretos los genera
# infra/gestion/secretos.sh en el servidor, fuera del repositorio.

HOST=0.0.0.0
PORT=1337

# Secretos: en local, cualquier valor largo y al azar. Nunca los del servidor.
APP_KEYS=cambiar1,cambiar2,cambiar3,cambiar4
API_TOKEN_SALT=cambiar
ADMIN_JWT_SECRET=cambiar
TRANSFER_TOKEN_SALT=cambiar
JWT_SECRET=cambiar
ENCRYPTION_KEY=cambiar

# PostgreSQL local (ver apps/gestion/README.md para levantarlo en un contenedor).
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=gestion
DATABASE_USERNAME=gestion
DATABASE_PASSWORD=gestion_local
DATABASE_SSL=false

# En local no hay nginx delante.
IS_PROXIED=false

# Sin telemetria ni avisos comerciales en el panel.
STRAPI_TELEMETRY_DISABLED=true
FLAG_NPS=false
FLAG_PROMOTE_EE=false
