{
  "name": "idiky-pwa",
  "private": true,
  "version": "0.1.0",
  "description": "Demo PWA de Idiky — gestion de copropiedad horizontal",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "empaquetar": "npm run build && node herramientas/empaquetar.mjs",
    "probar:navegador": "playwright test",
    "probar:navegador:instalar": "playwright install chromium"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
