  <diagram id="3._El_mapa:_" name="3. El mapa: dónde vive cada cliente">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n62" value="El mapa: dónde vive cada cliente y cómo se muda (ADR-0025 §4 y §5)" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1420" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n63" value="App de BLOKY&lt;br&gt;&lt;span style=&#39;font-weight:normal&#39;&gt;Administrador, Delegado…&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;strokeWidth=2;arcSize=12;fillColor=#f3effd;strokeColor=#8e6cef;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n64" value="ALICE&lt;br&gt;&lt;span style=&#39;font-weight:normal&#39;&gt;propietarios y residentes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;strokeWidth=2;arcSize=12;fillColor=#fdeef2;strokeColor=#e0607e;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n65" value="BOB&lt;br&gt;&lt;span style=&#39;font-weight:normal&#39;&gt;el equipo de IDIKY&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;strokeWidth=2;arcSize=12;fillColor=#eef1fb;strokeColor=#3d4b63;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n66" value="Ninguna de las tres conoce dónde están las bases: &lt;b&gt;solo hablan con el middleware&lt;/b&gt;. Si un cliente se muda, no cambian." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n67" value="Middleware de IDIKY&lt;br&gt;&lt;span style=&#39;font-weight:normal&#39;&gt;el único punto de acceso a la capa de datos: el único que toca las bases y lee el mapa&lt;/span&gt;&lt;br&gt;&lt;span style=&#39;font-weight:normal;font-size:10px&#39;&gt;código hoy en Bloky-Idiky/apps/bloky-api&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;strokeWidth=2;arcSize=12;fillColor=#ffffff;strokeColor=#8e6cef;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="330" y="150" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n68" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#8e6cef;" edge="1" parent="1" source="n63" target="n67">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n69" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#8e6cef;" edge="1" parent="1" source="n64" target="n67">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n70" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#8e6cef;" edge="1" parent="1" source="n65" target="n67">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n71" value="El mapa · en el esquema bloky (el núcleo, que no se muda)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;arcSize=4;strokeWidth=2;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="70" width="520" height="260" as="geometry" />
        </mxCell>
        <mxCell id="n72" value="&lt;b&gt;servidor_datos&lt;/b&gt;&lt;br&gt;nombre · dirección (host, puerto, base) · &lt;b&gt;nombre del secreto&lt;/b&gt; con su clave · estado&lt;br&gt;&lt;span style=&#39;font-family:monospace&#39;&gt;principal &amp;nbsp;· servidor de hoy · secreto BLOKY_BD_PRINCIPAL&lt;/span&gt;&lt;br&gt;&lt;span style=&#39;font-family:monospace&#39;&gt;grande-01 · otra infraestructura · secreto BLOKY_BD_GRANDE_01&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="680" y="105" width="480" height="95" as="geometry" />
        </mxCell>
        <mxCell id="n73" value="&lt;b&gt;ubicacion&lt;/b&gt; · una fila por pieza movible&lt;br&gt;&lt;span style=&#39;font-family:monospace&#39;&gt;directorio &amp;nbsp;&amp;nbsp;&amp;nbsp;→ principal · esquema directorio · activa&lt;br&gt;cp_altos &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;→ principal · esquema cp_altos · activa&lt;br&gt;cp_ciudadela → grande-01 · esquema cp_ciudadela · activa&lt;br&gt;(si tuviera su propio middleware: su dirección)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="680" y="210" width="480" height="105" as="geometry" />
        </mxCell>
        <mxCell id="n74" value="¿dónde vive&lt;br&gt;este cliente?" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.5;strokeColor=#e0782a;dashed=1;" edge="1" parent="1" source="n67" target="n71">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n75" value="Servidor «principal» · el de hoy" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;arcSize=4;strokeWidth=2;fillColor=#f3effd;strokeColor=#8e6cef;" vertex="1" parent="1">
          <mxGeometry x="330" y="420" width="520" height="330" as="geometry" />
