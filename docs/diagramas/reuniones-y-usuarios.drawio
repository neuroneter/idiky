<mxfile host="app.diagrams.net" agent="Claude" version="24.7.17"><diagram id="1._Quién_gua" name="1. Quién guarda qué"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="880" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="Usuarios y reuniones con video: quién guarda qué (ADR-0025)  ·  naranja punteado = lo que falta construir" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1420" height="40" as="geometry"/></mxCell><mxCell id="n2" value="BOB · back office de IDIKY (Strapi)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;arcSize=4;strokeWidth=2;fillColor=#eef1fb;strokeColor=#3d4b63;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="380" height="600" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Copropiedad / oficina&lt;/b&gt;&lt;br&gt;nombre, NIT, negocio (copropiedad | espacio de trabajo), estado" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="340" height="60" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;NUEVO · Módulo «Personas del cliente»&lt;/b&gt;&lt;br&gt;crea, cambia y finaliza al &lt;b&gt;Administrador&lt;/b&gt; y al &lt;b&gt;Delegado&lt;/b&gt;, pero &lt;b&gt;no los guarda&lt;/b&gt;: lee y escribe el directorio por la entrada de administración del &lt;b&gt;middleware de IDIKY&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="340" height="90" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Solicitud (el trámite)&lt;/b&gt;&lt;br&gt;cambio de Delegado o de Administrador: quién, canal, acta, estado · guarda &lt;b&gt;solo el id&lt;/b&gt; de la persona" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="280" width="340" height="70" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Plan y contratación&lt;/b&gt;&lt;br&gt;plan o servicio adicional, unidades, 12 meses, precio congelado" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="340" height="60" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;NUEVO · Derecho a reuniones&lt;/b&gt;&lt;br&gt;¿puede usar reuniones con video? (sí / no)&lt;br&gt;¿cuántas al mes? (cupo)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="430" width="340" height="80" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Se van de BOB&lt;/b&gt; (ADR-0025): &lt;s&gt;Persona&lt;/s&gt; y &lt;s&gt;Asignación&lt;/s&gt;. Primero se pasan al directorio y se verifican; se quitan del código al final, porque Strapi borra solas las tablas.&lt;br&gt;&lt;br&gt;Los usuarios de BOB (el equipo de IDIKY) siguen siendo cuentas de Strapi." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="340" height="130" as="geometry"/></mxCell><mxCell id="n9" value="La capa de datos de IDIKY · base «bloky», tres tipos de esquema · solo la toca el middleware" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;arcSize=4;strokeWidth=2;fillColor=#f3effd;strokeColor=#8e6cef;" vertex="1" parent="1"><mxGeometry x="530" y="70" width="460" height="800" as="geometry"/></mxCell><mxCell id="n10" value="Esquema &lt;b&gt;directorio&lt;/b&gt; · las personas (uno para todo IDIKY)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fillColor=#ffffff;strokeColor=#8e6cef;dashed=0;arcSize=4;" vertex="1" parent="1"><mxGeometry x="545" y="110" width="430" height="200" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;persona&lt;/b&gt;: tipo y número de documento, nombre, celular, correo · una sola en todo IDIKY" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="560" y="140" width="400" height="50" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;membresía&lt;/b&gt;: persona ↔ edificio u oficina · rol · desde / hasta · quién la gestiona (BOB o BLOKY)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="560" y="195" width="400" height="50" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;NUEVO · rol&lt;/b&gt;: el catálogo (administrador, delegado, propietario, residente, colaborador…)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="560" y="250" width="400" height="50" as="geometry"/></mxCell><mxCell id="n14" value="Esquema &lt;b&gt;bloky&lt;/b&gt; · el núcleo (no se muda)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fillColor=#ffffff;strokeColor=#8e6cef;arcSize=4;" vertex="1" parent="1"><mxGeometry x="545" y="320" width="430" height="120" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;ingreso&lt;/b&gt;&lt;br&gt;sesiones, intentos, Google y Microsoft · consumo · auditoría" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="560" y="350" width="195" height="80" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;NUEVO · el mapa&lt;/b&gt;&lt;br&gt;dónde vive el directorio y cada cliente (ver página 3)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="765" y="350" width="195" height="80" as="geometry"/></mxCell><mxCell id="n17" value="Esquema &lt;b&gt;cp_&amp;lt;id&amp;gt;&lt;/b&gt; · uno por cliente, idéntico (se puede mudar)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fillColor=#ffffff;strokeColor=#8e6cef;arcSize=4;" vertex="1" parent="1"><mxGeometry x="545" y="450" width="430" height="290" as="geometry"/></mxCell><mxCell id="n18" value="estructura, unidades, equipo, espacios, cartera… (lo que ya existe)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="560" y="480" width="400" height="40" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;FALTA · persona ↔ unidad&lt;/b&gt; (CU-B-07): propietario, arrendatario o residente" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="560" y="525" width="400" height="45" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;NUEVO · Reuniones&lt;/b&gt;: sala, anfitrión, invitados, inicio, duración · cuenta contra el cupo del mes" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="560" y="575" width="400" height="60" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;NUEVO · firma el pase&lt;/b&gt; (JWT) y entrega el enlace" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="560" y="640" width="400" height="40" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;NUEVO · responde&lt;/b&gt; a Jitsi cuánto dura la sala" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="560" y="688" width="400" height="40" as="geometry"/></mxCell><mxCell id="n23" value="El &lt;b&gt;middleware de IDIKY&lt;/b&gt; es el &lt;b&gt;único&lt;/b&gt; que toca la base: consulta el directorio y el esquema del cliente y une el resultado. &lt;b&gt;Nada cruza esquemas por SQL&lt;/b&gt;, por eso un cliente se puede mudar sin que nadie lo note.&lt;br&gt;Desaparece la copia desde BOB cada 15 min." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="545" y="750" width="430" height="110" as="geometry"/></mxCell><mxCell id="n24" value="Jitsi · las salas de video" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;arcSize=4;strokeWidth=2;fillColor=#e8f6f4;strokeColor=#26a69a;" vertex="1" parent="1"><mxGeometry x="1100" y="70" width="360" height="330" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;Hoy&lt;/b&gt;&lt;br&gt;abrir una sala exige cuenta de Prosody (AUTH_TYPE=internal); invitados por enlace y sala de espera" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1120" y="110" width="320" height="60" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;NUEVO · Modo pase&lt;/b&gt; (AUTH_TYPE=jwt)&lt;br&gt;solo acepta pases firmados por BLOKY; la sala de espera se queda" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1120" y="180" width="320" height="70" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b&gt;NUEVO · Cierra la sala a tiempo&lt;/b&gt;&lt;br&gt;pregunta a BLOKY la duración y cierra al cumplirse" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1120" y="260" width="320" height="60" as="geometry"/></mxCell><mxCell id="n28" value="Necesita salida hacia el middleware de IDIKY dentro del servidor (con cuidado: lo comparte LangFlow)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1120" y="330" width="320" height="50" as="geometry"/></mxCell><mxCell id="n29" value="ALICE · app del propietario y residente" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;arcSize=4;strokeWidth=2;fillColor=#fdeef2;strokeColor=#e0607e;" vertex="1" parent="1"><mxGeometry x="1100" y="440" width="360" height="170" as="geometry"/></mxCell><mxCell id="n30" value="Usa el &lt;b&gt;mismo directorio&lt;/b&gt; (ADR-0025 §6): entra por el middleware de IDIKY, nunca a la base.&lt;br&gt;Pide su enlace de la reunión y lo abre con jitsi_meet_flutter_sdk (Android e iOS)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1120" y="480" width="320" height="110" as="geometry"/></mxCell><mxCell id="n31" value="lee y escribe&lt;br&gt;Administrador&lt;br&gt;y Delegado&lt;br&gt;(middleware)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#3d4b63;" edge="1" parent="1" source="n4" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n32" value="BLOKY lee&lt;br&gt;derecho y cupo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#e0782a;dashed=1;" edge="1" parent="1" source="n7" target="n20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n33" value="enlace&lt;br&gt;con pase" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#26a69a;" edge="1" parent="1" source="n21" target="n26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n34" value="¿cuánto&lt;br&gt;dura?" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;strokeColor=#26a69a;dashed=1;" edge="1" parent="1" source="n27" target="n22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n35" value="entra con su&lt;br&gt;documento" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;exitX=0;exitY=0.3;entryX=1;entryY=0.5;strokeColor=#e0607e;" edge="1" parent="1" source="n29" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="2._Una_reuni" name="2. Una reunión, paso a paso"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="880" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n36" value="Una reunión con video, paso a paso" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1300" height="40" as="geometry"/></mxCell><mxCell id="n37" value="Administrador o Delegado" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=13;fontStyle=1;fillColor=#eef1fb;strokeColor=#3d4b63;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="245" height="820" as="geometry"/></mxCell><mxCell id="n38" value="Middleware de IDIKY (BLOKY)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=13;fontStyle=1;fillColor=#f3effd;strokeColor=#8e6cef;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="305" y="60" width="245" height="820" as="geometry"/></mxCell><mxCell id="n39" value="BOB" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=13;fontStyle=1;fillColor=#eef1fb;strokeColor=#3d4b63;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="570" y="60" width="245" height="820" as="geometry"/></mxCell><mxCell id="n40" value="Jitsi" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=13;fontStyle=1;fillColor=#e8f6f4;strokeColor=#26a69a;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="835" y="60" width="245" height="820" as="geometry"/></mxCell><mxCell id="n41" value="Invitado (ALICE o enlace)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=13;fontStyle=1;fillColor=#fdeef2;strokeColor=#e0607e;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1100" y="60" width="245" height="820" as="geometry"/></mxCell><mxCell id="n42" value="&lt;b&gt;1.&lt;/b&gt; Entra a BLOKY (código por SMS o Google / Microsoft) y crea una reunión: tema, fecha, hora, duración e invitados." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="52" y="100" width="221" height="70" as="geometry"/></mxCell><mxCell id="n43" value="&lt;b&gt;2.&lt;/b&gt; BLOKY le pregunta a BOB: ¿esta copropiedad tiene reuniones? ¿Cuántas al mes?" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="582" y="190" width="221" height="70" as="geometry"/></mxCell><mxCell id="n44" value="&lt;b&gt;3.&lt;/b&gt; Revisa el derecho, el rol de quien la crea y que no se pase del cupo del mes. Guarda la reunión." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="317" y="280" width="221" height="70" as="geometry"/></mxCell><mxCell id="n45" value="&lt;b&gt;4.&lt;/b&gt; Envía las invitaciones (correo, SMS o aviso en ALICE)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="317" y="370" width="221" height="70" as="geometry"/></mxCell><mxCell id="n46" value="&lt;b&gt;5.&lt;/b&gt; A la hora, pide «Abrir sala». BLOKY firma un pase de &lt;b&gt;anfitrión&lt;/b&gt; para esa sala y ese horario." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="52" y="460" width="221" height="70" as="geometry"/></mxCell><mxCell id="n47" value="&lt;b&gt;6.&lt;/b&gt; Comprueba el pase, abre la sala y le pregunta a BLOKY cuánto dura." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="847" y="550" width="221" height="70" as="geometry"/></mxCell><mxCell id="n48" value="&lt;b&gt;7.&lt;/b&gt; Abre su enlace (con pase sin anfitrión, o sin pase) y espera en la sala de espera." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1112" y="560" width="221" height="70" as="geometry"/></mxCell><mxCell id="n49" value="&lt;b&gt;8.&lt;/b&gt; El anfitrión lo admite. Se ven y se oyen." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="847" y="640" width="221" height="70" as="geometry"/></mxCell><mxCell id="n50" value="&lt;b&gt;9.&lt;/b&gt; Al cumplirse la duración, cierra la sala para todos. Fuera del horario el pase ya no deja entrar." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="847" y="730" width="221" height="70" as="geometry"/></mxCell><mxCell id="n51" value="&lt;b&gt;10.&lt;/b&gt; Registra la reunión como hecha y descuenta del cupo (consumo y bitácora)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="317" y="730" width="221" height="70" as="geometry"/></mxCell><mxCell id="n52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n42" target="n44"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n53" value="derecho y cupo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n43" target="n44"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n44" target="n45"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n55" value="invitación" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n45" target="n48"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n56" value="enlace con pase" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n46" target="n47"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n57" value="pide entrar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n48" target="n49"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n47" target="n49"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n49" target="n50"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n60" value="terminó" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n50" target="n51"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n61" value="Naranja punteado = falta construir. Hoy en BLOKY no hay nada de reuniones ni de Jitsi." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1100" y="800" width="240" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3._El_mapa:_" name="3. El mapa: dónde vive cada cliente"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="880" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n62" value="El mapa: dónde vive cada cliente y cómo se muda (ADR-0025 §4 y §5)" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1420" height="40" as="geometry"/></mxCell><mxCell id="n63" value="App de BLOKY&lt;br&gt;&lt;span style='font-weight:normal'&gt;Administrador, Delegado…&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;strokeWidth=2;arcSize=12;fillColor=#f3effd;strokeColor=#8e6cef;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="200" height="60" as="geometry"/></mxCell><mxCell id="n64" value="ALICE&lt;br&gt;&lt;span style='font-weight:normal'&gt;propietarios y residentes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;strokeWidth=2;arcSize=12;fillColor=#fdeef2;strokeColor=#e0607e;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="200" height="60" as="geometry"/></mxCell><mxCell id="n65" value="BOB&lt;br&gt;&lt;span style='font-weight:normal'&gt;el equipo de IDIKY&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;strokeWidth=2;arcSize=12;fillColor=#eef1fb;strokeColor=#3d4b63;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="200" height="60" as="geometry"/></mxCell><mxCell id="n66" value="Ninguna de las tres conoce dónde están las bases: &lt;b&gt;solo hablan con el middleware&lt;/b&gt;. Si un cliente se muda, no cambian." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="200" height="90" as="geometry"/></mxCell><mxCell id="n67" value="Middleware de IDIKY&lt;br&gt;&lt;span style='font-weight:normal'&gt;el único punto de acceso a la capa de datos: el único que toca las bases y lee el mapa&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;font-size:10px'&gt;código hoy en Bloky-Idiky/apps/bloky-api&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;strokeWidth=2;arcSize=12;fillColor=#ffffff;strokeColor=#8e6cef;fontSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="150" width="240" height="110" as="geometry"/></mxCell><mxCell id="n68" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#8e6cef;" edge="1" parent="1" source="n63" target="n67"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n69" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#8e6cef;" edge="1" parent="1" source="n64" target="n67"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n70" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#8e6cef;" edge="1" parent="1" source="n65" target="n67"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n71" value="El mapa · en el esquema bloky (el núcleo, que no se muda)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;arcSize=4;strokeWidth=2;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;" vertex="1" parent="1"><mxGeometry x="660" y="70" width="520" height="260" as="geometry"/></mxCell><mxCell id="n72" value="&lt;b&gt;servidor_datos&lt;/b&gt;&lt;br&gt;nombre · dirección (host, puerto, base) · &lt;b&gt;nombre del secreto&lt;/b&gt; con su clave · estado&lt;br&gt;&lt;span style='font-family:monospace'&gt;principal &amp;nbsp;· servidor de hoy · secreto BLOKY_BD_PRINCIPAL&lt;/span&gt;&lt;br&gt;&lt;span style='font-family:monospace'&gt;grande-01 · otra infraestructura · secreto BLOKY_BD_GRANDE_01&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="680" y="105" width="480" height="95" as="geometry"/></mxCell><mxCell id="n73" value="&lt;b&gt;ubicacion&lt;/b&gt; · una fila por pieza movible&lt;br&gt;&lt;span style='font-family:monospace'&gt;directorio &amp;nbsp;&amp;nbsp;&amp;nbsp;→ principal · esquema directorio · activa&lt;br&gt;cp_altos &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;→ principal · esquema cp_altos · activa&lt;br&gt;cp_ciudadela → grande-01 · esquema cp_ciudadela · activa&lt;br&gt;(si tuviera su propio middleware: su dirección)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="680" y="210" width="480" height="105" as="geometry"/></mxCell><mxCell id="n74" value="¿dónde vive&lt;br&gt;este cliente?" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.5;strokeColor=#e0782a;dashed=1;" edge="1" parent="1" source="n67" target="n71"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n75" value="Servidor «principal» · el de hoy" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;arcSize=4;strokeWidth=2;fillColor=#f3effd;strokeColor=#8e6cef;" vertex="1" parent="1"><mxGeometry x="330" y="420" width="520" height="330" as="geometry"/></mxCell><mxCell id="n76" value="&lt;b&gt;directorio&lt;/b&gt;&lt;br&gt;todas las personas" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="350" y="460" width="230" height="60" as="geometry"/></mxCell><mxCell id="n77" value="&lt;b&gt;bloky&lt;/b&gt;&lt;br&gt;ingreso · mapa · consumo" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="600" y="460" width="230" height="60" as="geometry"/></mxCell><mxCell id="n78" value="&lt;b&gt;cp_altos&lt;/b&gt;&lt;br&gt;un cliente, idéntico a los demás" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="350" y="540" width="230" height="60" as="geometry"/></mxCell><mxCell id="n79" value="&lt;b&gt;cp_torres&lt;/b&gt;&lt;br&gt;un cliente, idéntico a los demás" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="600" y="540" width="230" height="60" as="geometry"/></mxCell><mxCell id="n80" value="&lt;b&gt;cp_cowork93&lt;/b&gt;&lt;br&gt;un cliente, idéntico a los demás" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="350" y="620" width="230" height="60" as="geometry"/></mxCell><mxCell id="n81" value="&lt;b&gt;cp_…&lt;/b&gt;&lt;br&gt;un cliente, idéntico a los demás" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="600" y="620" width="230" height="60" as="geometry"/></mxCell><mxCell id="n82" value="Servidor «grande-01» · otra infraestructura (cuando haga falta)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;arcSize=4;strokeWidth=2;fillColor=#ffffff;strokeColor=#8e6cef;dashed=1;" vertex="1" parent="1"><mxGeometry x="940" y="420" width="320" height="200" as="geometry"/></mxCell><mxCell id="n83" value="&lt;b&gt;cp_ciudadela&lt;/b&gt;&lt;br&gt;un cliente grande que se mudó" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="960" y="480" width="280" height="60" as="geometry"/></mxCell><mxCell id="n84" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.3;entryY=0;strokeColor=#8e6cef;" edge="1" parent="1" source="n67" target="n75"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n85" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;exitX=1;exitY=0.9;entryX=0.3;entryY=0;strokeColor=#8e6cef;dashed=1;" edge="1" parent="1" source="n67" target="n82"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n86" value="&lt;b&gt;Mudar un cliente = cambiar una fila del mapa&lt;/b&gt;&lt;br&gt;1. Se marca «mudándose»: queda solo lectura unos minutos.&lt;br&gt;2. Se respalda su cp_&amp;lt;id&amp;gt; y se restaura en el servidor nuevo.&lt;br&gt;3. Se verifica (conteos, versión de migraciones).&lt;br&gt;4. Se cambia el servidor en su fila de &lt;i&gt;ubicacion&lt;/i&gt; y se marca «activa».&lt;br&gt;5. El esquema viejo queda retirado como respaldo; no se borra en el mismo paso.&lt;br&gt;&lt;br&gt;Sin cambiar código. Lo decide IDIKY con el «Consumo por copropiedad» de BOB." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="940" y="640" width="520" height="200" as="geometry"/></mxCell><mxCell id="n87" value="Las &lt;b&gt;claves&lt;/b&gt; de las bases nunca van en el mapa ni en git: el mapa guarda solo &lt;b&gt;el nombre del secreto&lt;/b&gt;, y los secretos viven en el servidor (como hoy secretos.sh). El directorio también se podría mudar entero, si ALICE crece mucho." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="860" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>