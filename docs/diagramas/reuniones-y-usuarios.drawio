          <mxGeometry x="350" y="460" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n77" value="&lt;b&gt;bloky&lt;/b&gt;&lt;br&gt;ingreso · mapa · consumo" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="600" y="460" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n78" value="&lt;b&gt;cp_altos&lt;/b&gt;&lt;br&gt;un cliente, idéntico a los demás" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="350" y="540" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n79" value="&lt;b&gt;cp_torres&lt;/b&gt;&lt;br&gt;un cliente, idéntico a los demás" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="600" y="540" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n80" value="&lt;b&gt;cp_cowork93&lt;/b&gt;&lt;br&gt;un cliente, idéntico a los demás" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="350" y="620" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n81" value="&lt;b&gt;cp_…&lt;/b&gt;&lt;br&gt;un cliente, idéntico a los demás" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="600" y="620" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n82" value="Servidor «grande-01» · otra infraestructura (cuando haga falta)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;arcSize=4;strokeWidth=2;fillColor=#ffffff;strokeColor=#8e6cef;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="940" y="420" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="n83" value="&lt;b&gt;cp_ciudadela&lt;/b&gt;&lt;br&gt;un cliente grande que se mudó" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="960" y="480" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n84" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.3;entryY=0;strokeColor=#8e6cef;" edge="1" parent="1" source="n67" target="n75">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n85" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;exitX=1;exitY=0.9;entryX=0.3;entryY=0;strokeColor=#8e6cef;dashed=1;" edge="1" parent="1" source="n67" target="n82">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n86" value="&lt;b&gt;Mudar un cliente = cambiar una fila del mapa&lt;/b&gt;&lt;br&gt;1. Se marca «mudándose»: queda solo lectura unos minutos.&lt;br&gt;2. Se respalda su cp_&amp;lt;id&amp;gt; y se restaura en el servidor nuevo.&lt;br&gt;3. Se verifica (conteos, versión de migraciones).&lt;br&gt;4. Se cambia el servidor en su fila de &lt;i&gt;ubicacion&lt;/i&gt; y se marca «activa».&lt;br&gt;5. El esquema viejo queda retirado como respaldo; no se borra en el mismo paso.&lt;br&gt;&lt;br&gt;Sin cambiar código. Lo decide IDIKY con el «Consumo por copropiedad» de BOB." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="940" y="640" width="520" height="200" as="geometry" />
        </mxCell>
        <mxCell id="n87" value="Las &lt;b&gt;claves&lt;/b&gt; de las bases nunca van en el mapa ni en git: el mapa guarda solo &lt;b&gt;el nombre del secreto&lt;/b&gt;, y los secretos viven en el servidor (como hoy secretos.sh). El directorio también se podría mudar entero, si ALICE crece mucho." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="780" width="860" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
