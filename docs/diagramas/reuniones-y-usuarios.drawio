<mxfile host="app.diagrams.net" agent="Claude" version="24.7.17"><diagram id="1._Quién_gua" name="1. Quién guarda qué"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="Usuarios y reuniones con video: quién guarda qué  ·  naranja punteado = lo que falta definir o construir" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1420" height="40" as="geometry"/></mxCell><mxCell id="n2" value="BOB · back office de IDIKY (Strapi)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;arcSize=4;strokeWidth=2;fillColor=#eef1fb;strokeColor=#3d4b63;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="380" height="560" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Copropiedad / oficina&lt;/b&gt;&lt;br&gt;nombre, NIT, negocio (copropiedad | espacio de trabajo), estado" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="340" height="70" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Persona&lt;/b&gt;&lt;br&gt;tipo de documento (CC, CE, PA, PPT, TI), número, celular, correo&lt;br&gt;&lt;i&gt;solo Administrador y Delegado&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="340" height="80" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Asignación&lt;/b&gt;&lt;br&gt;persona ↔ copropiedad · rol: &lt;b&gt;administrador | delegado&lt;/b&gt; · vigente / finalizada / bloqueada" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="280" width="340" height="70" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Plan y contratación&lt;/b&gt;&lt;br&gt;plan o servicio adicional, unidades, 12 meses, precio congelado" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="340" height="70" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;NUEVO · Derecho a reuniones&lt;/b&gt;&lt;br&gt;¿puede usar reuniones con video? (sí / no)&lt;br&gt;¿cuántas al mes? (cupo)&lt;br&gt;&lt;i&gt;¿campo del plan o servicio adicional?&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="340" height="90" as="geometry"/></mxCell><mxCell id="n8" value="BOB &lt;b&gt;no&lt;/b&gt; guarda residentes ni crea reuniones. Solo habilita y fija el cupo (decisión de Daniel, 2026-10-20)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="540" width="340" height="70" as="geometry"/></mxCell><mxCell id="n9" value="BLOKY · la operación de cada copropiedad" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;arcSize=4;strokeWidth=2;fillColor=#f3effd;strokeColor=#8e6cef;" vertex="1" parent="1"><mxGeometry x="530" y="70" width="460" height="720" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Directorio · persona&lt;/b&gt; (bloky.persona)&lt;br&gt;tipo y número de documento, nombre, celular, correo&lt;br&gt;origen: &lt;b&gt;bob&lt;/b&gt; (copia) | &lt;b&gt;bloky&lt;/b&gt; (creada aquí) · una persona es una sola en todo IDIKY" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="550" y="110" width="420" height="80" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Directorio · membresía&lt;/b&gt; (bloky.membresia)&lt;br&gt;persona ↔ copropiedad u oficina · rol · desde / hasta · estado&lt;br&gt;&lt;i&gt;una persona puede tener varios roles en varios lugares&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="550" y="200" width="420" height="80" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;FALTA · catálogo de roles&lt;/b&gt;&lt;br&gt;hoy el rol es texto libre: administrador, delegado, propietario, residente, colaborador…" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="550" y="290" width="420" height="60" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;FALTA · persona ↔ unidad&lt;/b&gt; (CU-B-07)&lt;br&gt;propietario, arrendatario o residente de cada apartamento u oficina" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="550" y="360" width="420" height="60" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;NUEVO · Reuniones&lt;/b&gt;&lt;br&gt;sala, anfitrión, invitados, inicio, duración, estado&lt;br&gt;cuenta contra el cupo del mes (usa la tabla de consumo)&lt;br&gt;&lt;i&gt;quién la crea: Administrador, Delegado o un perfil autorizado&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="550" y="430" width="420" height="100" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;NUEVO · Entrega el enlace con pase&lt;/b&gt;&lt;br&gt;firma el pase (JWT): sala, anfitrión sí/no, desde (nbf), hasta (exp)&lt;br&gt;clave compartida solo con Jitsi" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="550" y="540" width="420" height="70" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;NUEVO · Responde la duración&lt;/b&gt;&lt;br&gt;Jitsi pregunta al abrir la sala: inicio y segundos" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="550" y="620" width="420" height="50" as="geometry"/></mxCell><mxCell id="n17" value="Ya existe: copia de BOB cada 15 min (BOB manda; si no responde, se usa la copia) · el rol se comprueba en cada petición · bitácora y consumo por cliente (ADR-0022)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="550" y="680" width="420" height="90" as="geometry"/></mxCell><mxCell id="n18" value="Jitsi · las salas de video" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;arcSize=4;strokeWidth=2;fillColor=#e8f6f4;strokeColor=#26a69a;" vertex="1" parent="1"><mxGeometry x="1100" y="70" width="360" height="330" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Hoy&lt;/b&gt;&lt;br&gt;abrir una sala exige cuenta de Prosody (AUTH_TYPE=internal); invitados por enlace y sala de espera" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1120" y="110" width="320" height="60" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;NUEVO · Modo pase&lt;/b&gt; (AUTH_TYPE=jwt)&lt;br&gt;solo acepta pases firmados por BLOKY; la sala de espera se queda" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1120" y="180" width="320" height="70" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;NUEVO · Cierra la sala a tiempo&lt;/b&gt;&lt;br&gt;pregunta a BLOKY la duración y cierra al cumplirse" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1120" y="260" width="320" height="60" as="geometry"/></mxCell><mxCell id="n22" value="Para preguntarle a BLOKY necesita salida hacia la API de BLOKY dentro del servidor (con cuidado: lo comparte LangFlow)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1120" y="330" width="320" height="50" as="geometry"/></mxCell><mxCell id="n23" value="ALICE · app del propietario y residente" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;arcSize=4;strokeWidth=2;fillColor=#fdeef2;strokeColor=#e0607e;" vertex="1" parent="1"><mxGeometry x="1100" y="440" width="360" height="150" as="geometry"/></mxCell><mxCell id="n24" value="Pide a BLOKY su enlace de la reunión y lo abre con jitsi_meet_flutter_sdk (Android e iOS).&lt;br&gt;&lt;i&gt;Abierto (T-80): ¿ALICE usa el mismo directorio de BLOKY?&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1120" y="480" width="320" height="90" as="geometry"/></mxCell><mxCell id="n25" value="copia Administrador&lt;br&gt;y Delegado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#3d4b63;" edge="1" parent="1" source="n4" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n26" value="lee el derecho&lt;br&gt;y el cupo&lt;br&gt;(no escribe)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#e0782a;dashed=1;" edge="1" parent="1" source="n7" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n27" value="enlace&lt;br&gt;con pase" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#26a69a;" edge="1" parent="1" source="n15" target="n20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n28" value="¿cuánto&lt;br&gt;dura?" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;strokeColor=#26a69a;dashed=1;" edge="1" parent="1" source="n21" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n29" value="pide su enlace" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;exitX=0;exitY=0.7;entryX=1;entryY=0.8;strokeColor=#e0607e;" edge="1" parent="1" source="n23" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="2._Una_reuni" name="2. Una reunión, paso a paso"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n30" value="Una reunión con video, paso a paso" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1300" height="40" as="geometry"/></mxCell><mxCell id="n31" value="Administrador o Delegado" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=13;fontStyle=1;fillColor=#eef1fb;strokeColor=#3d4b63;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="245" height="820" as="geometry"/></mxCell><mxCell id="n32" value="BLOKY" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=13;fontStyle=1;fillColor=#f3effd;strokeColor=#8e6cef;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="305" y="60" width="245" height="820" as="geometry"/></mxCell><mxCell id="n33" value="BOB" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=13;fontStyle=1;fillColor=#eef1fb;strokeColor=#3d4b63;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="570" y="60" width="245" height="820" as="geometry"/></mxCell><mxCell id="n34" value="Jitsi" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=13;fontStyle=1;fillColor=#e8f6f4;strokeColor=#26a69a;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="835" y="60" width="245" height="820" as="geometry"/></mxCell><mxCell id="n35" value="Invitado (ALICE o enlace)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=13;fontStyle=1;fillColor=#fdeef2;strokeColor=#e0607e;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1100" y="60" width="245" height="820" as="geometry"/></mxCell><mxCell id="n36" value="&lt;b&gt;1.&lt;/b&gt; Entra a BLOKY (código por SMS o Google / Microsoft) y crea una reunión: tema, fecha, hora, duración e invitados." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="52" y="100" width="221" height="70" as="geometry"/></mxCell><mxCell id="n37" value="&lt;b&gt;2.&lt;/b&gt; (Ya copiado en BLOKY) ¿Esta copropiedad tiene reuniones? ¿Cuántas al mes?" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="582" y="190" width="221" height="70" as="geometry"/></mxCell><mxCell id="n38" value="&lt;b&gt;3.&lt;/b&gt; Revisa el derecho, el rol de quien la crea y que no se pase del cupo del mes. Guarda la reunión." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="317" y="280" width="221" height="70" as="geometry"/></mxCell><mxCell id="n39" value="&lt;b&gt;4.&lt;/b&gt; Envía las invitaciones (correo, SMS o aviso en ALICE)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="317" y="370" width="221" height="70" as="geometry"/></mxCell><mxCell id="n40" value="&lt;b&gt;5.&lt;/b&gt; A la hora, pide «Abrir sala». BLOKY firma un pase de &lt;b&gt;anfitrión&lt;/b&gt; para esa sala y ese horario." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="52" y="460" width="221" height="70" as="geometry"/></mxCell><mxCell id="n41" value="&lt;b&gt;6.&lt;/b&gt; Comprueba el pase, abre la sala y le pregunta a BLOKY cuánto dura." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="847" y="550" width="221" height="70" as="geometry"/></mxCell><mxCell id="n42" value="&lt;b&gt;7.&lt;/b&gt; Abre su enlace (con pase sin anfitrión, o sin pase) y espera en la sala de espera." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1112" y="560" width="221" height="70" as="geometry"/></mxCell><mxCell id="n43" value="&lt;b&gt;8.&lt;/b&gt; El anfitrión lo admite. Se ven y se oyen." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="847" y="640" width="221" height="70" as="geometry"/></mxCell><mxCell id="n44" value="&lt;b&gt;9.&lt;/b&gt; Al cumplirse la duración, cierra la sala para todos. Fuera del horario el pase ya no deja entrar." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="847" y="730" width="221" height="70" as="geometry"/></mxCell><mxCell id="n45" value="&lt;b&gt;10.&lt;/b&gt; Registra la reunión como hecha y descuenta del cupo (consumo y bitácora)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="317" y="730" width="221" height="70" as="geometry"/></mxCell><mxCell id="n46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n36" target="n38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n47" value="derecho y cupo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n37" target="n38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n38" target="n39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n49" value="invitación" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n39" target="n42"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n50" value="enlace con pase" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n40" target="n41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n51" value="pide entrar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n42" target="n43"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n41" target="n43"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n43" target="n44"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n54" value="terminó" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n44" target="n45"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n55" value="Naranja punteado = falta construir. Hoy en BLOKY no hay nada de reuniones ni de Jitsi." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1100" y="800" width="240" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>