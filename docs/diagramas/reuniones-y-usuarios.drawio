  <diagram id="1._Quién_gua" name="1. Quién guarda qué">
    <mxGraphModel dx="1653" dy="910" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n1" parent="1" style="text;html=1;fontSize=18;fontStyle=1;align=left;" value="Usuarios y reuniones con video: quién guarda qué (ADR-0025)  ·  naranja punteado = lo que falta construir" vertex="1">
          <mxGeometry height="40" width="1420" x="40" y="10" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;arcSize=4;strokeWidth=2;fillColor=#eef1fb;strokeColor=#3d4b63;" value="BOB · back office de IDIKY (Strapi)" vertex="1">
          <mxGeometry height="600" width="380" x="40" y="70" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" value="&lt;b&gt;Copropiedad / oficina&lt;/b&gt;&lt;br&gt;nombre, NIT, negocio (copropiedad | espacio de trabajo), estado" vertex="1">
          <mxGeometry height="60" width="340" x="60" y="110" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" value="&lt;b&gt;NUEVO · Módulo «Personas del cliente»&lt;/b&gt;&lt;br&gt;crea, cambia y finaliza al &lt;b&gt;Administrador&lt;/b&gt; y al &lt;b&gt;Delegado&lt;/b&gt;, pero &lt;b&gt;no los guarda&lt;/b&gt;: lee y escribe el directorio por la entrada de administración del &lt;b&gt;middleware de IDIKY&lt;/b&gt;" vertex="1">
          <mxGeometry height="90" width="340" x="60" y="180" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" value="&lt;b&gt;Solicitud (el trámite)&lt;/b&gt;&lt;br&gt;cambio de Delegado o de Administrador: quién, canal, acta, estado · guarda &lt;b&gt;solo el id&lt;/b&gt; de la persona" vertex="1">
          <mxGeometry height="70" width="340" x="60" y="280" as="geometry" />
        </mxCell>
        <mxCell id="n6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" value="&lt;b&gt;Plan y contratación&lt;/b&gt;&lt;br&gt;plan o servicio adicional, unidades, 12 meses, precio congelado" vertex="1">
          <mxGeometry height="60" width="340" x="60" y="360" as="geometry" />
        </mxCell>
        <mxCell id="n7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" value="&lt;b&gt;NUEVO · Derecho a reuniones&lt;/b&gt;&lt;br&gt;¿puede usar reuniones con video? (sí / no)&lt;br&gt;¿cuántas al mes? (cupo)" vertex="1">
          <mxGeometry height="80" width="340" x="60" y="430" as="geometry" />
        </mxCell>
        <mxCell id="n8" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" value="&lt;b&gt;Se van de BOB&lt;/b&gt; (ADR-0025): &lt;s&gt;Persona&lt;/s&gt; y &lt;s&gt;Asignación&lt;/s&gt;. Primero se pasan al directorio y se verifican; se quitan del código al final, porque Strapi borra solas las tablas.&lt;br&gt;&lt;br&gt;Los usuarios de BOB (el equipo de IDIKY) siguen siendo cuentas de Strapi." vertex="1">
          <mxGeometry height="130" width="340" x="60" y="520" as="geometry" />
        </mxCell>
        <mxCell id="n9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;arcSize=4;strokeWidth=2;fillColor=#f3effd;strokeColor=#8e6cef;" value="La capa de datos de IDIKY · base «bloky», tres tipos de esquema · solo la toca el middleware" vertex="1">
          <mxGeometry height="800" width="460" x="530" y="70" as="geometry" />
        </mxCell>
        <mxCell id="n10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fillColor=#ffffff;strokeColor=#8e6cef;dashed=0;arcSize=4;" value="Esquema &lt;b&gt;directorio&lt;/b&gt; · las personas (uno para todo IDIKY)" vertex="1">
          <mxGeometry height="200" width="430" x="545" y="110" as="geometry" />
        </mxCell>
        <mxCell id="n11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" value="&lt;b&gt;persona&lt;/b&gt;: tipo y número de documento, nombre, celular, correo · una sola en todo IDIKY" vertex="1">
          <mxGeometry height="50" width="400" x="560" y="140" as="geometry" />
        </mxCell>
        <mxCell id="n12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" value="&lt;b&gt;asignación&lt;/b&gt;: persona ↔ edificio u oficina · rol · desde / hasta · quién la gestiona (BOB o el lugar) · una persona tiene varias" vertex="1">
          <mxGeometry height="50" width="400" x="560" y="195" as="geometry" />
        </mxCell>
        <mxCell id="n13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" value="&lt;b&gt;NUEVO · rol&lt;/b&gt;: el catálogo (administrador, delegado, propietario, residente, colaborador…)" vertex="1">
          <mxGeometry height="50" width="400" x="560" y="250" as="geometry" />
        </mxCell>
        <mxCell id="n14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fillColor=#ffffff;strokeColor=#8e6cef;arcSize=4;" value="Esquema &lt;b&gt;bloky&lt;/b&gt; · el núcleo (no se muda)" vertex="1">
          <mxGeometry height="120" width="430" x="545" y="320" as="geometry" />
        </mxCell>
        <mxCell id="n15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" value="&lt;b&gt;ingreso&lt;/b&gt;&lt;br&gt;sesiones, intentos, Google y Microsoft · consumo · auditoría" vertex="1">
          <mxGeometry height="80" width="195" x="560" y="350" as="geometry" />
        </mxCell>
        <mxCell id="n16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" value="&lt;b&gt;NUEVO · el mapa&lt;/b&gt;&lt;br&gt;dónde vive el directorio y cada cliente (ver página 3)" vertex="1">
          <mxGeometry height="80" width="195" x="765" y="350" as="geometry" />
        </mxCell>
        <mxCell id="n17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fillColor=#ffffff;strokeColor=#8e6cef;arcSize=4;" value="Esquema &lt;b&gt;cp_&amp;lt;id&amp;gt;&lt;/b&gt; · uno por cliente, idéntico (se puede mudar)" vertex="1">
          <mxGeometry height="290" width="430" x="545" y="450" as="geometry" />
        </mxCell>
        <mxCell id="n18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" value="estructura, unidades, equipo, espacios, cartera… (lo que ya existe)" vertex="1">
          <mxGeometry height="40" width="400" x="560" y="480" as="geometry" />
        </mxCell>
        <mxCell id="n19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" value="&lt;b&gt;FALTA · persona ↔ unidad&lt;/b&gt; (CU-B-07): propietario, arrendatario o residente" vertex="1">
          <mxGeometry height="45" width="400" x="560" y="525" as="geometry" />
        </mxCell>
        <mxCell id="n20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" value="&lt;b&gt;NUEVO · Reuniones&lt;/b&gt;: sala, anfitrión, invitados, inicio, duración · cuenta contra el cupo del mes" vertex="1">
          <mxGeometry height="60" width="400" x="560" y="575" as="geometry" />
        </mxCell>
        <mxCell id="n21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" value="&lt;b&gt;NUEVO · firma el pase&lt;/b&gt; (JWT) y entrega el enlace" vertex="1">
          <mxGeometry height="40" width="400" x="560" y="640" as="geometry" />
        </mxCell>
        <mxCell id="n22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" value="&lt;b&gt;NUEVO · responde&lt;/b&gt; a Jitsi cuánto dura la sala" vertex="1">
          <mxGeometry height="40" width="400" x="560" y="688" as="geometry" />
        </mxCell>
        <mxCell id="n23" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" value="El &lt;b&gt;middleware de IDIKY&lt;/b&gt; es el &lt;b&gt;único&lt;/b&gt; que toca la base: consulta el directorio y el esquema del cliente y une el resultado. &lt;b&gt;Nada cruza esquemas por SQL&lt;/b&gt;, por eso un cliente se puede mudar sin que nadie lo note.&lt;br&gt;Desaparece la copia desde BOB cada 15 min." vertex="1">
          <mxGeometry height="110" width="430" x="545" y="750" as="geometry" />
        </mxCell>
        <mxCell id="n24" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;arcSize=4;strokeWidth=2;fillColor=#e8f6f4;strokeColor=#26a69a;" value="Jitsi · las salas de video" vertex="1">
          <mxGeometry height="330" width="360" x="1100" y="70" as="geometry" />
        </mxCell>
        <mxCell id="n25" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" value="&lt;b&gt;Hoy&lt;/b&gt;&lt;br&gt;abrir una sala exige cuenta de Prosody (AUTH_TYPE=internal); invitados por enlace y sala de espera" vertex="1">
          <mxGeometry height="60" width="320" x="1120" y="110" as="geometry" />
        </mxCell>
        <mxCell id="n26" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" value="&lt;b&gt;NUEVO · Modo pase&lt;/b&gt; (AUTH_TYPE=jwt)&lt;br&gt;solo acepta pases firmados por BLOKY; la sala de espera se queda" vertex="1">
          <mxGeometry height="70" width="320" x="1120" y="180" as="geometry" />
        </mxCell>
        <mxCell id="n27" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" value="&lt;b&gt;NUEVO · Cierra la sala a tiempo&lt;/b&gt;&lt;br&gt;pregunta a BLOKY la duración y cierra al cumplirse" vertex="1">
          <mxGeometry height="60" width="320" x="1120" y="260" as="geometry" />
        </mxCell>
        <mxCell id="n28" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;" value="Necesita salida hacia el middleware de IDIKY dentro del servidor (con cuidado: lo comparte LangFlow)." vertex="1">
          <mxGeometry height="50" width="320" x="1120" y="330" as="geometry" />
        </mxCell>
        <mxCell id="n29" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;arcSize=4;strokeWidth=2;fillColor=#fdeef2;strokeColor=#e0607e;" value="ALICE · app del propietario y residente" vertex="1">
          <mxGeometry height="170" width="360" x="1100" y="440" as="geometry" />
        </mxCell>
        <mxCell id="n30" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#ffffff;" value="Usa el &lt;b&gt;mismo directorio&lt;/b&gt; (ADR-0025 §6): entra por el middleware de IDIKY, nunca a la base.&lt;br&gt;Pide su enlace de la reunión y lo abre con jitsi_meet_flutter_sdk (Android e iOS)." vertex="1">
          <mxGeometry height="110" width="320" x="1120" y="480" as="geometry" />
        </mxCell>
        <mxCell id="n31" edge="1" parent="1" source="n4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#3d4b63;" target="n12" value="lee y escribe&lt;br&gt;Administrador&lt;br&gt;y Delegado&lt;br&gt;(middleware)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n32" edge="1" parent="1" source="n7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#e0782a;dashed=1;" target="n20" value="BLOKY lee&lt;br&gt;derecho y cupo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n33" edge="1" parent="1" source="n21" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#26a69a;" target="n26" value="enlace&lt;br&gt;con pase">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n34" edge="1" parent="1" source="n27" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;strokeColor=#26a69a;dashed=1;" target="n22" value="¿cuánto&lt;br&gt;dura?">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n35" edge="1" parent="1" source="n29" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.6;labelBackgroundColor=#ffffff;exitX=0;exitY=0.3;entryX=1;entryY=0.5;strokeColor=#e0607e;" target="n10" value="entra con su&lt;br&gt;documento">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="2._Una_reuni" name="2. Una reunión, paso a paso">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n36" value="Una reunión con video, paso a paso" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n37" value="Administrador o Delegado" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=13;fontStyle=1;fillColor=#eef1fb;strokeColor=#3d4b63;strokeWidth=2;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="245" height="820" as="geometry" />
        </mxCell>
        <mxCell id="n38" value="Middleware de IDIKY (BLOKY)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=13;fontStyle=1;fillColor=#f3effd;strokeColor=#8e6cef;strokeWidth=2;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="305" y="60" width="245" height="820" as="geometry" />
        </mxCell>
        <mxCell id="n39" value="BOB" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=13;fontStyle=1;fillColor=#eef1fb;strokeColor=#3d4b63;strokeWidth=2;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="570" y="60" width="245" height="820" as="geometry" />
        </mxCell>
        <mxCell id="n40" value="Jitsi" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=13;fontStyle=1;fillColor=#e8f6f4;strokeColor=#26a69a;strokeWidth=2;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="835" y="60" width="245" height="820" as="geometry" />
        </mxCell>
        <mxCell id="n41" value="Invitado (ALICE o enlace)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=13;fontStyle=1;fillColor=#fdeef2;strokeColor=#e0607e;strokeWidth=2;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="1100" y="60" width="245" height="820" as="geometry" />
        </mxCell>
        <mxCell id="n42" value="&lt;b&gt;1.&lt;/b&gt; Entra a BLOKY (código por SMS o Google / Microsoft) y crea una reunión: tema, fecha, hora, duración e invitados." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="52" y="100" width="221" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n43" value="&lt;b&gt;2.&lt;/b&gt; BLOKY le pregunta a BOB: ¿esta copropiedad tiene reuniones? ¿Cuántas al mes?" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="582" y="190" width="221" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n44" value="&lt;b&gt;3.&lt;/b&gt; Revisa el derecho, el rol de quien la crea y que no se pase del cupo del mes. Guarda la reunión." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="317" y="280" width="221" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n45" value="&lt;b&gt;4.&lt;/b&gt; Envía las invitaciones (correo, SMS o aviso en ALICE)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="317" y="370" width="221" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n46" value="&lt;b&gt;5.&lt;/b&gt; A la hora, pide «Abrir sala». BLOKY firma un pase de &lt;b&gt;anfitrión&lt;/b&gt; para esa sala y ese horario." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="52" y="460" width="221" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n47" value="&lt;b&gt;6.&lt;/b&gt; Comprueba el pase, abre la sala y le pregunta a BLOKY cuánto dura." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="847" y="550" width="221" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n48" value="&lt;b&gt;7.&lt;/b&gt; Abre su enlace (con pase sin anfitrión, o sin pase) y espera en la sala de espera." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1112" y="560" width="221" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n49" value="&lt;b&gt;8.&lt;/b&gt; El anfitrión lo admite. Se ven y se oyen." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="847" y="640" width="221" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n50" value="&lt;b&gt;9.&lt;/b&gt; Al cumplirse la duración, cierra la sala para todos. Fuera del horario el pase ya no deja entrar." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=8;fillColor=#fff4e5;strokeColor=#e0782a;dashed=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="847" y="730" width="221" height="70" as="geometry" />
        </mxCell>
